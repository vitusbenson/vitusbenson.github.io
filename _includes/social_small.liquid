{% assign s = site.data.socials %}
{% if s.email %}
  <a href="mailto:{{ s.email | encode_email }}" title="email"><i class="fa-solid fa-envelope"></i></a>
{% endif %}
{% if s.scholar_userid %}
  <a href="https://scholar.google.com/citations?user={{ s.scholar_userid }}" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>
{% endif %}
{% if s.linkedin_username %}
  <a href="https://www.linkedin.com/in/{{ s.linkedin_username }}" title="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
{% endif %}
{% if s.x_username %}
  <a href="https://twitter.com/{{ s.x_username }}" title="X"><i class="fa-brands fa-x-twitter"></i></a>
{% endif %}
{% if s.bluesky_url %}
  <a href="https://bsky.app/profile/{{ s.bluesky_url }}" title="Bluesky"><i class="fa-brands fa-bluesky"></i></a>
{% endif %}
